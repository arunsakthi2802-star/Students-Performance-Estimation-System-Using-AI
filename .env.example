# Environment Variables Template
# Students Performance Estimation System Using AI
# Project Owner: Nithyasri S

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Students Performance Estimation System Using AI"
PROJECT_OWNER="Nithyasri S"
VERSION="1.0.0"

# Backend & Security Secrets
SECRET_KEY="super-secret-key-nithyasri-mca-project-2026-secure-jwt-token"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for zero-setup, PostgreSQL ready)
DATABASE_URL="sqlite:///./student_performance.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/student_performance_db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Server Port
PORT=8000
HOST="127.0.0.1"
