# Environment Variables Template
# Students Performance Estimation System Using AI
# Project Owner: Nithyasri S

# Application Configuration
ENVIRONMENT=development
PROJECT_NAME="Students Performance Estimation System Using AI"
PROJECT_OWNER="Nithyasri S"
VERSION="1.0.0"

# Backend Security & JWT Secret Key
SECRET_KEY="super-secret-key-nithyasri-mca-project-2026-secure-jwt-token"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite Local Relational Database URL
DATABASE_URL="sqlite:///./student_performance.db"

# MongoDB Atlas Connection URL
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>"

# Server Network Configuration
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Vite API Base URL
VITE_API_URL="http://127.0.0.1:8000/api/v1"
